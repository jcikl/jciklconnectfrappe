rules_version = '2';

// GENERATED by `npm run gen:rules` from the DocType registry. Do not edit by hand.
// Reads are scoped by org through userAccess/{uid}. Every client write is denied:
// all writes go through the /api/resource save pipeline.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function access() {
      return get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data;
    }

    function hasRole(role, d) {
      let scopes = access().scopes;
      return role in scopes && (d.orgId in scopes[role].exact || d.orgPath.hasAny(scopes[role].subtree));
    }

    function hasRoleAnywhere(role) {
      return role in access().scopes;
    }

    function isOwner(d) {
      let personId = access().personId;
      return personId != null && d.ownerPersonId == personId;
    }

    match /userAccess/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /customFields/{id} {
      allow read: if signedIn() && (hasRoleAnywhere('SystemManager') || hasRoleAnywhere('OrgAdmin') || hasRoleAnywhere('MembershipOfficer') || hasRoleAnywhere('Treasurer') || hasRoleAnywhere('BoardMember') || hasRoleAnywhere('Member'));
      allow write: if false;
    }

    match /organizations/{id} {
      allow read: if signedIn() && (hasRole('SystemManager', resource.data) || hasRole('OrgAdmin', resource.data) || hasRole('MembershipOfficer', resource.data) || hasRole('Treasurer', resource.data) || hasRole('BoardMember', resource.data) || hasRole('Member', resource.data));
      allow write: if false;
    }

    match /roleAssignments/{id} {
      allow read: if signedIn() && (hasRole('SystemManager', resource.data) || hasRole('OrgAdmin', resource.data));
      allow write: if false;
    }

    match /versions/{id} {
      allow read: if signedIn() && ((resource.data.doctype == 'CustomField' && (hasRoleAnywhere('SystemManager') || hasRoleAnywhere('OrgAdmin') || hasRoleAnywhere('MembershipOfficer') || hasRoleAnywhere('Treasurer') || hasRoleAnywhere('BoardMember') || hasRoleAnywhere('Member')))
        || (resource.data.doctype == 'Organization' && (hasRole('SystemManager', resource.data) || hasRole('OrgAdmin', resource.data) || hasRole('MembershipOfficer', resource.data) || hasRole('Treasurer', resource.data) || hasRole('BoardMember', resource.data) || hasRole('Member', resource.data)))
        || (resource.data.doctype == 'RoleAssignment' && (hasRole('SystemManager', resource.data) || hasRole('OrgAdmin', resource.data))));
      allow write: if false;
    }
  }
}
